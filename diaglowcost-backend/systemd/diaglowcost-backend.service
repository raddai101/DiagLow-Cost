[Unit]
Description=DiagLow-Cost FastAPI backend
After=network.target postgresql.service ollama.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/diaglowcost-backend
EnvironmentFile=/opt/diaglowcost-backend/.env
ExecStart=/opt/diaglowcost-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
